# Salin ke .env dan isi API key (JANGAN commit .env)

# Otak agen: Hermes Agent via gateway OpenAI-compatible lokal
# Jalankan Hermes gateway (default: http://127.0.0.1:8642), lalu isi API_SERVER_KEY-nya.
LLM_PROVIDER=hermes
HERMES_BASE_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Cadangan: Groq (gratis) - daftar di https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Opsional
PORT=8787
APP_TIMEZONE=Asia/Jakarta
